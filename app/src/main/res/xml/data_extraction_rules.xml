<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted prefs — EncryptedSharedPreferences uses hardware-bound keys;
             restoring to a different device would produce undecryptable data. -->
        <exclude domain="sharedpref" path="ptoda_prefs.xml" />
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>